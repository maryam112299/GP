# Database configuration
SQLITE_DB_PATH=agent_security_tester.db

# Authentication
# Change this to a long random secret in production
JWT_SECRET=super-secret-key-change-me

# Expiry for the access token in hours
JWT_EXPIRE_HOURS=24

# LLM (Ollama)
# The analyzer model (planner). llama3:8b is the new default; switch back
# to mistral by changing this line if you want to A/B compare.
OLLAMA_MODEL=llama3:8b
OLLAMA_BASE_URL=http://localhost:11434

# PAIR attacker/refiner backend.
#   local      → Ollama (analyzer model)            — no key, default
#   groq       → Groq big model (REFINER_GROQ_MODEL) — needs GROQ_API_KEY below
#   anthropic  → Claude                              — needs ANTHROPIC_API_KEY
# The UI dropdown can override this per-run; this is just the env default.
# Safe to use "groq" now that the refiner has its OWN key (REFINER_GROQ_API_KEY
# below), separate from the victim mini-app's GROQ_API_KEY — so the 70B attacker
# no longer competes with the victim's quota.
REFINER_BACKEND=groq
REFINER_GROQ_MODEL=llama-3.3-70b-versatile

# Groq API key for the VICTIM mini-app (NovaBank/HR). Keep this dedicated to the
# victim so it never gets rate-limited by our own attacker traffic.
GROQ_API_KEY=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

# SEPARATE Groq key for the PAIR refiner (the Llama-3.3-70B attacker). Having its
# own key means the attacker and the victim have independent rate limits.
REFINER_GROQ_API_KEY=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

# ---------------------------------------------------------------------------
# Performance / reliability tuning (added to tame Ollama contention).
# The victim, judge, and analyzer all share one local Ollama, so heavy
# concurrency causes timeouts → retries → more load. These keep it sane.
# ---------------------------------------------------------------------------
# FREE-TIER MODE — minimize victim Groq tokens & avoid 429 bursts.
# Serialize everything and pace victim calls so we stay near the 6k TPM cap.
PAIR_MAX_WORKERS=1            # one victim call at a time
PAIR_MAX_ATTEMPTS=3          # fewer refinements per goal
ENCODE_VARIANTS=1            # one encoded variant per payload (not 3)
MAX_COVERAGE_TOOLS=3        # cap extra Tool-Authorization goals
VERIFY_STATE_CHANGE=0       # skip the extra read-back victim call
VICTIM_RETRIES=2
# Global pacing between victim calls (seconds). Higher = fewer 429s, slower.
# 15 is a balance; raise to 25-30 if you still see rate-limit replies.
VICTIM_MIN_INTERVAL_SEC=15
# Discovery: one short round, serialized.
DISCOVERY_ROUNDS=1
DISCOVERY_PROBES_PER_ROUND=3
DISCOVERY_MAX_WORKERS=1
DISCOVERY_RETRIES=2

# Server
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Port for the backend FastAPI server
BACKEND_PORT=8000
